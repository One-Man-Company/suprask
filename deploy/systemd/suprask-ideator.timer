[Unit]
Description=SUPRASK — ideator (kasdien 2 langai (07:10, 07:40))

[Timer]
# Sugeneruota iš agents/run.py ROLES. Nekeisk ranka — paleisk deploy/gen_timers.py.
OnCalendar=*-*-* 07:10:00
OnCalendar=*-*-* 07:40:00
Persistent=true
RandomizedDelaySec=240
Unit=suprask-agent@ideator.service

[Install]
WantedBy=timers.target
