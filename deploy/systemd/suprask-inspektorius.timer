[Unit]
Description=SUPRASK — gyvos svetainės patikra (ketvirtadienis)

[Timer]
# Ketvirtadienis: po antradienio PR ir trečiadienio publikavimo — tikrinama tai, kas jau gyva.
OnCalendar=Thu *-*-* 06:50:00
Persistent=true
RandomizedDelaySec=300
Unit=suprask-agent@sveikatos-inspektorius.service

[Install]
WantedBy=timers.target
