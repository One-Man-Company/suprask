[Unit]
Description=SUPRASK — kalbu-redaktorius (antradieniais, penktadieniais)

[Timer]
# Sugeneruota iš agents/run.py ROLES. Nekeisk ranka — paleisk deploy/gen_timers.py.
OnCalendar=Tue,Fri *-*-* 13:10:00
Persistent=true
RandomizedDelaySec=240
Unit=suprask-agent@kalbu-redaktorius.service

[Install]
WantedBy=timers.target
