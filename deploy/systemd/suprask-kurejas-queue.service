[Unit]
Description=SUPRASK — kurejas eilė (kasdien)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/home/zoltanas/workspace/suprask
Environment="PATH=/home/zoltanas/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="SUPRASK_HERMES_BIN=/home/zoltanas/.local/bin/hermes"
ExecStart=/usr/bin/python3 /home/zoltanas/workspace/suprask/scripts/kurejas_queue.py --max-items 8 --max-minutes 180
TimeoutStartSec=16200
Nice=10
StandardOutput=journal
StandardError=journal
