[Unit]
Description=SUPRASK — simuliaciju-inzinierius (kasdien)

[Timer]
# Sugeneruota iš agents/run.py ROLES. Nekeisk ranka — paleisk deploy/gen_timers.py.
OnCalendar=*-*-* 11:00:00
Persistent=true
RandomizedDelaySec=240
Unit=suprask-agent@simuliaciju-inzinierius.service

[Install]
WantedBy=timers.target
