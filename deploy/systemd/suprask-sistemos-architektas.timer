[Unit]
Description=SUPRASK — sistemos-architektas (kasdien)

[Timer]
# Sugeneruota iš agents/run.py ROLES. Nekeisk ranka — paleisk deploy/gen_timers.py.
OnCalendar=*-*-* 20:20:00
Persistent=true
RandomizedDelaySec=240
Unit=suprask-agent@sistemos-architektas.service

[Install]
WantedBy=timers.target
