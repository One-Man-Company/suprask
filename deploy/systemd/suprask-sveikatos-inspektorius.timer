[Unit]
Description=SUPRASK — sveikatos-inspektorius (ketvirtadieniais)

[Timer]
# Sugeneruota iš agents/run.py ROLES. Nekeisk ranka — paleisk deploy/gen_timers.py.
OnCalendar=Thu *-*-* 06:50:00
Persistent=true
RandomizedDelaySec=240
Unit=suprask-agent@sveikatos-inspektorius.service

[Install]
WantedBy=timers.target
